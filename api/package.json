{
  "name": "paritario-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Paritario: comités paritarios (DS 44/2024)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.901.0",
    "@aws-sdk/client-s3": "3.901.0",
    "@aws-sdk/client-secrets-manager": "3.901.0",
    "@aws-sdk/client-sesv2": "3.901.0",
    "@aws-sdk/rds-signer": "3.901.0",
    "@aws-sdk/s3-request-presigner": "3.901.0",
    "fastify": "5.6.1",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
